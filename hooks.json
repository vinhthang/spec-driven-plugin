{
  "spec-gate-plugin": {
    "PreToolUse": [
      {
        "matcher": "^(?:default_api:|client:)?(invoke_subagent|write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 ./scripts/spec-gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
